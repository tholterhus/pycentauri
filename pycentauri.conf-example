# pycentauri service configuration
# Copy this file to /etc/pycentauri.conf and adapt it locally.
# Keep the installed configuration readable only by root and the service user.
HOST=printer.example
ACCESS_CODE=
PORT=8787
BIND=127.0.0.1
RTSP=0
ENABLE_CONTROL=0
# Log verbosity: info | warn | critical (default: warn)
LOG_LEVEL=warn
MEDIAMTX_PATH=
# Failed-print (spaghetti) detection; see docs/CORAL_SPAGHETTI_DETECTION.md.
# notify-only by default — pause/stop additionally require ENABLE_CONTROL=1.
DETECT=0
# auto = the bundled trained spaghetti model (data/models wins if you put one there)
DETECT_MODEL=auto
DETECT_ACTION=notify
DETECT_THRESHOLD=0.65
# Seconds between analyzed frames (default 1; raise to reduce CPU/TPU load).
DETECT_INTERVAL=1
# Optional Telegram push: alerts on detection AND print-state changes
# (paused / filament switch / aborted / finished / error), each with a
# camera frame. Bot via @BotFather; empty values disable it.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional bot password (BotFather): attached to every Telegram request as
# the secret-token header. Nothing is ever received from Telegram.
TELEGRAM_PASSWORD=
# Chamber-light automation (needs ENABLE_CONTROL=1): light on at print start,
# off once the nozzle cools below this threshold while idle. Consumed by the
# service unit's ExecStart as --light-cool-temp ${LIGHT_COOL_TEMP}.
LIGHT_COOL_TEMP=50

# Chamber-heating automation (needs ENABLE_CONTROL=1): armed at print start
# when the bed target exceeds HEATING_BED_TEMP or the filename contains one
# of HEATING_MATERIALS (comma-separated, case-insensitive). While armed, the
# printer's chamber sensor drives the Shelly-controlled heater between
# HEATING_CHAMBER_MIN (ON) and HEATING_CHAMBER_MAX (OFF); the heater goes
# off when the print ends. Settings edited in the web UI persist in
# data/heating.json and win over these defaults.
HEATING=0
HEATING_URL_ON=
HEATING_URL_OFF=
HEATING_BED_TEMP=90
HEATING_CHAMBER_TARGET=42.5
HEATING_CHAMBER_HYSTERESIS=5
HEATING_CHAMBER_OVERSHOOT=0
# Safety cap: the highest chamber target any source (UI, slicer) may set.
HEATING_TARGET_MAX=60
HEATING_MATERIALS=ABS,ASA
